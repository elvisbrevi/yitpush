<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package as Tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>yp</ToolCommandName>

    <!-- Package Metadata -->
    <PackageId>YitPush</PackageId>
    <Version>2.3.0</Version>
    <Authors>Elvis Brevi</Authors>
    <Description>AI-powered git commit and PR description tool with multi-provider support (OpenAI, Anthropic, Google Gemini, DeepSeek, OpenRouter, NVIDIA NIM) and full Azure DevOps management.</Description>

    <!-- URLs and Repository -->
    <PackageProjectUrl>https://yp.elvisbrevi.cl/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/elvisbrevi/yitpush</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Tags for discoverability -->
    <PackageTags>
      git;commit;ai;openai;anthropic;gemini;deepseek;openrouter;nvidia;nim;azure-devops;automation;cli;tool;dotnet-tool;conventional-commits;pull-request;developer-tools</PackageTags>

    <!-- License -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- README -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Additional Metadata -->
    <Copyright>Copyright (c) 2026 Elvis Brevi</Copyright>
    <PackageReleaseNotes>- Added NVIDIA NIM as a sixth AI provider. `yp setup` now lists "NVIDIA NIM"; the NIM endpoint at `https://integrate.api.nvidia.com/v1` is OpenAI-compatible so the existing chat-completions path serves it. Live model discovery hits `GET /v1/models` with `Authorization: Bearer $NVIDIA_API_KEY` and caches the result for 24h. On-prem NIM deployments can override the base URL via the stored config. The `NVIDIA_API_KEY` environment variable overrides the stored key at runtime.
- Added `--assigned-to` flag on `task update` (accepts UPN, display name, or empty string to clear). Resolves the input against the project's identity store and writes the proper identity object. Multiple matches exit 4 with a candidate list.
- Added `yp --version` / `yp -V` global flag (prints "2.3.0" on stdout, exit 0, no ANSI escapes)
- Added `--json` flag to `hu show`, `task show`, and `hu list` — emits a flat JSON object suitable for piping to `jq`
- Fixed Spectre.Console crash on `hu show` / `hu list` when stdout is redirected (the trailing interactive prompt is now auto-skipped in non-interactive contexts)
- `yp azure-devops link &lt;org&gt; &lt;proj&gt; &lt;id&gt; --repo &lt;r&gt; --branch &lt;b&gt;` now honors quick mode for both HUs and Tasks (issue #9). Both flags together skip the interactive menu and create the ArtifactLink directly. For Tasks, the `Custom.URLCommit` field is also written as a legacy fallback (no-op if the field doesn't exist).
- 29 new unit tests: 22 in `AddLinkToRepoHelpersTests` (URL construction, menu-skip predicate, repo lookup, JSON-Patch body builder, link route end-to-end flag parsing) and 7 in `ProviderDispatchTests` (NIM routing decision, base URL, fallback model list, `FetchModelsForProvider` with a hand-rolled `HttpMessageHandler` stub, Bearer-token header propagation, custom base URL for on-prem NIM, and `GetAiInfo` env-var override via `NVIDIA_API_KEY`).
Full changelog: https://github.com/elvisbrevi/yitpush/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="TextCopy" Version="6.2.1" />
  </ItemGroup>

</Project>
